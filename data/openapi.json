                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/webhook/outreach/job-match": {
            "post": {
                "tags": [
                    "outreach-agent"
                ],
                "summary": "Webhook Handler",
                "description": "Handle webhook events from Supabase for job match notifications.\n\nThis endpoint receives webhook events when a new job application is created\nin the `job_application_tracking` table. It validates the webhook secret,\nextracts candidate and requirement IDs, and queues notification processing.\n\nArgs:\n    payload: Webhook payload from Supabase (JSON body)\n    request: FastAPI request object (for accessing app state)\n    x_webhook_secret: Webhook secret header for authentication\n    \nReturns:\n    WebhookResponse with status and queued task information\n    \nRaises:\n    HTTPException: If webhook secret is invalid or payload is malformed",
                "operationId": "webhook_handler_webhook_outreach_job_match_post",
                "parameters": [
                    {
                        "name": "X-Webhook-Secret",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "X-Webhook-Secret"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/app__api__outreach_agent__schemas__WebhookPayload"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WebhookResponse"
                                }
                            }
                        }
                    },
                    "422": {
