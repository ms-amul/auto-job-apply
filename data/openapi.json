        "/api/requirement/{requirement_id}": {
            "get": {
                "tags": [
                    "requirement-details"
                ],
                "summary": "Get Requirement Details",
                "description": "Get requirement details by ID.\n\nThis endpoint executes the Beta_usp_Get_Requirement_Details stored procedure\nwith the provided requirement_id and company_id, and returns requirement\ndetails with user-friendly field names.\n\nRate limiting is applied via the limiter from app state.\n\nArgs:\n    request: FastAPI request object (for rate limiting)\n    requirement_id: The requirement ID to fetch (required, must be > 0)\n    company_id: Company ID (default: 1, must be > 0)\n    \nReturns:\n    RequirementDetailsResponse: Requirement details with mapped field names\n    \nRaises:\n    HTTPException:\n        - 404: If requirement is not found\n        - 500: If database operation fails",
                "operationId": "get_requirement_details_api_requirement__requirement_id__get",
                "parameters": [
                    {
                        "name": "requirement_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Requirement Id"
                        }
                    },
                    {
                        "name": "company_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "description": "Company ID (default: 1)",
                            "default": 1,
                            "title": "Company Id"
                        },
                        "description": "Company ID (default: 1)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RequirementDetailsResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
