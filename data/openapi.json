        "/resume-intake/process-resume": {
            "post": {
                "tags": [
                    "resume-intake"
                ],
                "summary": "Process Resume Endpoint",
                "description": "Process a resume file and update database records.\n\nAccepts PDF, DOCX, or TXT files and processes them through the pipeline:\n1. Extract text from resume\n2. Structure data using GPT-4o\n3. Update records in Supabase database (auto_apply_cand and parsed_cand_resume)\n4. Generate and store embeddings in Qdrant\n\nNote: Rate limiting is configured at the application level (10 requests per minute per IP).\n\nArgs:\n    request: FastAPI request object (for caching)\n    file: Uploaded resume file (PDF, DOCX, or TXT)\n    candidate_id: Candidate ID from logged-in user (required)\n    \nReturns:\n    JSON response with success status and candidate_id\n    \nRaises:\n    HTTPException: If file type is unsupported, candidate_id is invalid, or processing fails",
                "operationId": "process_resume_endpoint_resume_intake_process_resume_post",
                "parameters": [
                    {
                        "name": "candidate_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "description": "Candidate ID from logged-in user (required)",
                            "title": "Candidate Id"
                        },
                        "description": "Candidate ID from logged-in user (required)"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Body_process_resume_endpoint_resume_intake_process_resume_post"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
