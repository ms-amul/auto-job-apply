{
    "openapi": "3.1.0",
    "info": {
        "title": "AutoApply Candidate Sync API",
        "description": "Unified FastAPI application for candidate synchronization, job application webhooks, resume processing, job recommendations, requirement details, and outreach notifications",
        "version": "6.0.0"
    },
    "paths": {
        "/webhook/cand-job-matching": {
            "post": {
                "tags": [
                    "webhook"
                ],
                "summary": "Webhook Listener",
                "description": "Webhook endpoint to listen for Supabase events on cand_job_matching table\n\nThis endpoint:\n1. Receives webhook events from Supabase\n2. Validates the event (INSERT on cand_job_matching table)\n3. Checks if similarity_score >= 0.7\n4. Fetches candidate data from auto_apply_cand table\n5. Executes Usp_SC_JobSeeker_IU_ApplyJob stored procedure",
                "operationId": "webhook_listener_webhook_cand_job_matching_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/app__api__apply_webhook__models__WebhookPayload"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
